# Application
PORT=8080
BASE_URL=/
ENVIRONMENT=development

# Puffer BFF (internal backend-for-frontend service)
PUFFER_BFF_URL=<puffer-bff-base-url>

# Blockchain
ETH_RPC_URL=<ethereum-rpc-url>

# AI advisor — pick ONE free provider (recommended: Groq)
# https://console.groq.com — free tier, no credit card for dev usage
GROQ_API_KEY=<groq-api-key>
# https://aistudio.google.com/apikey — Gemini free tier
# GEMINI_API_KEY=<google-api-key>
# Paid: OpenAI
# LLM_API_KEY=<openai-api-key>
# LLM_PROVIDER=groq|gemini|openai
# LLM_MODEL=llama-3.3-70b-versatile

# Advanced stake: any-token swap via 1inch (mainnet only)
# Proxied via GET /swap/quote and /swap/transaction when set.
# Also bundled for direct browser fallback if the proxy is unavailable.
ONE_INCH_API_KEY=<1inch-api-key>
